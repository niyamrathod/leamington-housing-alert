# Copy this file to .env and fill in real values for LOCAL TESTING ONLY.
# .env is gitignored and must never be committed. In production (GitHub
# Actions), these same names are set as repo secrets instead.

# Gmail account used to SEND alert emails.
GMAIL_ADDRESS=youraddress@gmail.com

# Gmail App Password (NOT your normal Gmail password).
# 1. Turn on 2-Step Verification on your Google account.
# 2. Generate one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your16charapppassword

# Comma-separated list of email addresses that should receive the digest.
ALERT_RECIPIENTS=you@example.com,friend@example.com

# healthchecks.io check-in URL - pinged after every successful run so
# healthchecks.io can email you if the scheduled run ever stops happening
# or starts erroring. Create a free check at https://healthchecks.io and
# paste its ping URL here. Optional locally - leave blank and the ping is
# just skipped.
HEALTHCHECK_URL=
